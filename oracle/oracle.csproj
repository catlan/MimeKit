<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MimeKitOracle</RootNamespace>
    <AssemblyName>oracle</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- NOT InvariantGlobalization: the parity target is MimeKit with the
         CodePages provider registered (MimeKitLite references it and the
         upstream test suite registers it). Culture is pinned in Program.cs. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference MimeKitLite so the oracle can only exercise in-scope APIs. -->
    <ProjectReference Include="../MimeKit/MimeKitLite.csproj" SetTargetFramework="TargetFramework=net10.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="9.0.9" />
  </ItemGroup>

</Project>
