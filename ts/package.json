{
  "name": "mimekit",
  "version": "1.0.0",
  "description": "TypeScript port of MimeKit (Lite scope): non-throwing Result-based MIME parsing/creation, byte-parity verified against the C# implementation",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/mime-parser.js",
    "./dist/smime/index.js",
    "./dist/smime/mime-message-crypto.js",
    "./dist/openpgp/index.js"
  ],
  "homepage": "https://catlan.github.io/MimeKit/",
  "bugs": "https://github.com/catlan/MimeKit/issues",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./dkim": {
      "types": "./dist/dkim/index.d.ts",
      "default": "./dist/dkim/index.js"
    },
    "./smime": {
      "types": "./dist/smime/index.d.ts",
      "default": "./dist/smime/index.js"
    },
    "./openpgp": {
      "types": "./dist/openpgp/index.d.ts",
      "default": "./dist/openpgp/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs": "typedoc",
    "docs:json": "typedoc --json docs/api.json --out docs"
  },
  "devDependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@openpgp/web-stream-tools": "^0.3.1",
    "@types/node": "^24.0.0",
    "asn1js": "^3.0.10",
    "openpgp": "^6.3.1",
    "pkijs": "^3.4.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "punycode": "2.3.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/catlan/MimeKit.git",
    "directory": "ts"
  },
  "keywords": [
    "mime",
    "email",
    "parser",
    "mimekit",
    "rfc2822",
    "rfc2045",
    "rfc2047",
    "tnef",
    "mbox"
  ],
  "peerDependencies": {
    "@noble/curves": "^2",
    "@noble/hashes": "^2",
    "asn1js": "*",
    "openpgp": "^6",
    "pkijs": "*"
  },
  "peerDependenciesMeta": {
    "@noble/hashes": {
      "optional": true
    },
    "@noble/curves": {
      "optional": true
    },
    "pkijs": {
      "optional": true
    },
    "asn1js": {
      "optional": true
    },
    "openpgp": {
      "optional": true
    }
  }
}