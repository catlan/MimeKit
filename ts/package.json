{
  "name": "mimekit-ts",
  "version": "0.0.0",
  "description": "TypeScript port of MimeKit (Lite scope): non-throwing Result-based MIME parsing/creation, byte-parity verified against the C# implementation",
  "license": "MIT",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dkim": {
      "types": "./dist/dkim/index.d.ts",
      "default": "./dist/dkim/index.js"
    },
    "./smime": {
      "types": "./dist/smime/index.d.ts",
      "default": "./dist/smime/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs": "typedoc",
    "docs:json": "typedoc --json docs/api.json --out docs"
  },
  "devDependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@peculiar/asn1-cms": "^2.8.0",
    "@peculiar/asn1-schema": "^2.8.0",
    "@peculiar/asn1-x509": "^2.8.0",
    "@peculiar/x509": "^2.0.0",
    "@types/node": "^24.0.0",
    "asn1js": "^3.0.10",
    "pkijs": "^3.4.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "punycode": "2.3.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/catlan/MimeKit.git",
    "directory": "ts"
  },
  "keywords": [
    "mime",
    "email",
    "parser",
    "mimekit",
    "rfc2822",
    "rfc2045",
    "rfc2047",
    "tnef",
    "mbox"
  ],
  "peerDependencies": {
    "@noble/curves": "^2",
    "@noble/hashes": "^2",
    "pkijs": "*",
    "@peculiar/x509": "*",
    "@peculiar/asn1-schema": "*",
    "@peculiar/asn1-x509": "*",
    "@peculiar/asn1-cms": "*",
    "asn1js": "*"
  },
  "peerDependenciesMeta": {
    "@noble/hashes": {
      "optional": true
    },
    "@noble/curves": {
      "optional": true
    },
    "pkijs": {
      "optional": true
    },
    "@peculiar/x509": {
      "optional": true
    },
    "@peculiar/asn1-schema": {
      "optional": true
    },
    "@peculiar/asn1-x509": {
      "optional": true
    },
    "@peculiar/asn1-cms": {
      "optional": true
    },
    "asn1js": {
      "optional": true
    }
  }
}
