{
  "name": "mimekit-ts",
  "version": "0.0.0",
  "description": "TypeScript port of MimeKit (Lite scope): non-throwing Result-based MIME parsing/creation, byte-parity verified against the C# implementation",
  "license": "MIT",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "punycode": "2.3.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/catlan/MimeKit.git",
    "directory": "ts"
  },
  "keywords": [
    "mime",
    "email",
    "parser",
    "mimekit",
    "rfc2822",
    "rfc2045",
    "rfc2047",
    "tnef",
    "mbox"
  ]
}
